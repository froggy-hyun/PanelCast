# Google Cloud & Gemini Configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_REGION=asia-northeast3
GCS_BUCKET_NAME=your-private-gcs-bucket
GEMINI_API_KEY=your-gemini-api-key
GEMINI_ANALYSIS_MODEL=gemini-4-argon
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_FALLBACK_MODEL=gemini-3.8-flash-lite-tts

# Service Mode: "web" (public web & publisher API), "worker" (private worker only), or "all" (local dev only)
PANELCAST_SERVICE_MODE=all

# Cloud Tasks & Worker Authentication
CLOUD_TASKS_QUEUE=panelcast-episode-queue
CLOUD_TASKS_LOCATION=asia-northeast3
WORKER_SERVICE_URL=https://panelcast-worker-xxxx.a.run.app
WORKER_SERVICE_ACCOUNT_EMAIL=panelcast-tasks-invoker@your-gcp-project-id.iam.gserviceaccount.com
WORKER_OIDC_AUDIENCE=https://panelcast-worker-xxxx.a.run.app

# Publisher Authentication (Firebase Admin & Client)
ALLOWED_PUBLISHER_UIDS=uid1,uid2
ALLOWED_PUBLISHER_EMAILS=publisher@gcplab.me
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Budget & Concurrency Limits
MAX_CONCURRENT_MODEL_CALLS=2
EPISODE_MAX_MODEL_CALLS_BUDGET=600
